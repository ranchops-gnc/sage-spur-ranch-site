---
interface Props {
  label: string;
  note?: string;
  tall?: boolean;
}

const { label, note = 'Original photography required before public launch.', tall = false } = Astro.props;
---
<figure class:list={['photo-slot', { tall }]} aria-label={`${label}. ${note}`}>
  <span>Photo field</span>
  <figcaption>
    <strong>{label}</strong>
    <small>{note}</small>
  </figcaption>
</figure>

<style>
  .photo-slot {
    min-height: 21rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    border: 1px solid var(--ink);
    background: var(--sage-wash);
    color: var(--ink);
  }
  .photo-slot.tall { min-height: 36rem; }
  .photo-slot > span {
    width: fit-content;
    padding: .35rem .55rem;
    background: var(--ink);
    color: var(--paper);
    font: 700 .68rem/1 var(--sans);
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  figcaption { display: grid; gap: .25rem; max-width: 22rem; }
  figcaption strong { font-family: var(--serif); font-size: 1.4rem; }
  figcaption small { font-size: .76rem; }
</style>
