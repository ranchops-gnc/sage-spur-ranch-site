---
const path = Astro.url.pathname;
const links: Array<[string, string]> = [
  ['/about/', 'About'], ['/programs/', 'Programs'], ['/events/', 'Events'],
  ['/journal/', 'Journal'], ['/contact/', 'Contact'],
];
---
<header class="site-header">
  <div class="masthead container">
    <a class="brand" href="/" aria-label="Sage and Spur Ranch home">
      <span class="brand-mark" aria-hidden="true">S+S</span>
      <span class="brand-words"><strong>Sage & Spur Ranch</strong><small>Colorado field notes</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Primary navigation">
        {links.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </details>
    <a class="button header-cta" href="/contact/">Start a conversation</a>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--rule); background: color-mix(in srgb, var(--paper) 93%, transparent); backdrop-filter: blur(12px); }
  .masthead { min-height: 5rem; display: grid; grid-template-columns: minmax(15rem, 1fr) auto auto; align-items: center; gap: 1.6rem; }
  .brand { display: flex; align-items: center; gap: .8rem; color: var(--ink); text-decoration: none; }
  .brand-mark { display: grid; width: 2.9rem; height: 2.9rem; place-items: center; border: 1px solid currentColor; border-radius: 50%; font: 800 .73rem/1 var(--sans); letter-spacing: .05em; }
  .brand-words { display: grid; line-height: 1.05; }
  .brand strong { font-family: var(--serif); font-size: 1.12rem; }
  .brand small { margin-top: .3rem; color: var(--muted); font-size: .61rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .mobile-nav { display: none; }
  nav { display: flex; gap: 1.15rem; }
  nav a { color: var(--ink); font-size: .78rem; font-weight: 800; text-decoration: none; }
  nav a:hover, nav a[aria-current='page'] { color: var(--leather); text-decoration: underline; text-underline-offset: .35rem; }
  .header-cta { font-size: .72rem; }
  @media (max-width: 980px) {
    .masthead { grid-template-columns: 1fr auto; }
    .header-cta { display: none; }
    .desktop-nav { display: none; }
    .mobile-nav { position: relative; display: block; }
    summary { display: block; cursor: pointer; font-weight: 800; }
    nav { position: absolute; right: 0; top: 2.4rem; width: min(20rem, calc(100vw - 2rem)); display: none; padding: 1.2rem; border: 1px solid var(--rule); background: var(--paper); box-shadow: var(--shadow); }
    details[open] nav { display: grid; }
  }
  @media (max-width: 420px) { .brand-words small { display: none; } }
</style>
