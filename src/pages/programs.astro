---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Programs | Sage & Spur Ranch" description="Explore the developing programs at Sage & Spur Ranch.">
  <header class="page-intro"><div class="container"><span class="eyebrow">Programs</span><h1>Learn by doing. Grow with purpose.</h1><p class="lead">Future Sage & Spur programs will be built around useful skills, responsible care, and real connection to the Western way of life.</p></div></header>
  <section class="section"><div class="container"><div class="program-grid"><article><span>01</span><h2>Horsemanship</h2><p>Foundational instruction and hands-on learning shaped around safety, care, and confidence.</p><p class="note"><strong>[Confirm]</strong> Program format, ages, availability, and pricing.</p></article><article><span>02</span><h2>Ranch Skills</h2><p>Practical, land-connected learning for those drawn to the rhythms and responsibilities of ranch life.</p><p class="note"><strong>[Confirm]</strong> Curriculum, dates, and participation requirements.</p></article><article><span>03</span><h2>Community Gatherings</h2><p>Small moments to share stories, celebrate the season, and meet people who value a grounded Western life.</p><p class="note"><strong>[Confirm]</strong> Event schedule and RSVP details.</p></article></div></div></section>
</BaseLayout>
<style>.program-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}.program-grid article{padding:1.5rem;border:1px solid var(--rule);background:#fff9ef}.program-grid article>span{color:var(--turquoise-dark);font-weight:850}@media(max-width:760px){.program-grid{grid-template-columns:1fr}}</style>
