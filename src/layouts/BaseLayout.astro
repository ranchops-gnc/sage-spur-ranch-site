---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  article?: { publishedAt: Date; category: string };
}

const { title, description, canonical = new URL(Astro.url.pathname, Astro.site).toString(), article } = Astro.props;
const structuredData = article
  ? {
      '@context': 'https://schema.org', '@type': 'Article',
      headline: title.replace(' | Sage & Spur Ranch', ''), description,
      datePublished: article.publishedAt.toISOString(), articleSection: article.category,
      author: { '@type': 'Person', name: 'Reins Rider' },
      publisher: { '@type': 'Organization', name: 'Sage & Spur Ranch' },
      mainEntityOfPage: canonical,
    }
  : {
      '@context': 'https://schema.org', '@type': 'WebSite',
      name: 'Sage & Spur Ranch', alternateName: 'Prairie Field Notes',
      url: 'https://sagespurranch.farm/', description,
    };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3eddf" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Sage & Spur Ranch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
